APP_PORT=8080
# development | production - production mengaktifkan flag Secure di cookie
# access_token (butuh HTTPS). Biarkan "development" untuk kerja lokal.
APP_ENV=development
DATABASE_URL=postgres://cncuser:cncpassword@localhost:5432/cnc_pm_db?sslmode=disable
REDIS_URL=localhost:6379
# Wajib diisi, tidak ada default - dipakai menandatangani JWT access token.
# Generate secret acak, jangan pakai nilai contoh ini di production:
# openssl rand -hex 32
JWT_SECRET=

# Opsional - kalau kosong, server tetap jalan tapi semua notifikasi email
# akan gagal terkirim (tercatat di tabel notifications). Contoh Gmail:
# host=smtp.gmail.com, port=587, user=alamat gmail, pass=App Password
# (bukan password akun biasa - generate di myaccount.google.com/apppasswords).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
